# User Service environment configuration
# Copy to .env for local development.
# Never commit .env.

# JWT
JWT_SECRET=replace_with_a_minimum_32_character_secret
JWT_EXPIRATION=3600000

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bema_user_db
SPRING_DATASOURCE_USERNAME=replace-with-database-user
SPRING_DATASOURCE_PASSWORD=replace-with-database-password

# Internal services
IDENTITY_SERVICE_URL=http://localhost:8084

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
